{
  "name": "registry",
  "version": "1.0.0",
  "description": "Onchain registry contract",
  "homepage": "https://github.com/cowrie-dev/onchain-registry#readme",
  "bugs": {
    "url": "https://github.com/cowrie-dev/onchain-registry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cowrie-dev/onchain-registry.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npx hardhat test",
    "deploy": "op run --env-file=.env.ref -- npx hardhat run scripts/deploy.ts --network ${NETWORK:-sepolia}",
    "deploy:create3": "op run --env-file=.env.ref -- npx hardhat run scripts/deploy-create3.ts",
    "register-schema": "op run --env-file=.env.ref -- hardhat run scripts/register-schema.ts --network ${NETWORK:-sepolia}",
    "registry:trust-attester": "op run --env-file=.env.ref -- hardhat run scripts/actions/trust-attester.ts --network ${NETWORK:-sepolia}",
    "registry:untrust-attester": "op run --env-file=.env.ref -- hardhat run scripts/actions/untrust-attester.ts --network ${NETWORK:-sepolia}",
    "registry:list-trusted-attesters": "hardhat run scripts/actions/list-trusted-attesters.ts --network ${NETWORK:-sepolia}",
    "registry:sanction": "op run --env-file=.env.ref -- hardhat run scripts/actions/sanction.ts --network ${NETWORK:-sepolia}",
    "registry:unsanction": "op run --env-file=.env.ref -- hardhat run scripts/actions/unsanction.ts --network ${NETWORK:-sepolia}",
    "registry:check": "op run --env-file=.env.ref -- hardhat run scripts/actions/check.ts --network ${NETWORK:-sepolia}",
    "registry:list-sanctioned": "op run --env-file=.env.ref -- hardhat run scripts/actions/list-sanctioned.ts --network ${NETWORK:-sepolia}",
    "registry:transfer-owner": "op run --env-file=.env.ref -- hardhat run scripts/actions/transfer-ownership.ts --network ${NETWORK:-sepolia}"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.2",
    "@types/node": "^22.19.17",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.6",
    "typescript": "~5.8.0",
    "viem": "^2.37.12"
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-contracts": "^1.8.0",
    "@openzeppelin/contracts": "^5.4.0"
  }
}
